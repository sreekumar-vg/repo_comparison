   "source": [
    "orders = spark.table(\"prd_catalog.bronze.orders\")\n",
    "orders = orders.withColumn(\"net_amount\", orders.amount - orders.discount)\n",
    "orders.write.mode(\"overwrite\").saveAsTable(\"prd_catalog.silver.orders\")"
   ]
  }
